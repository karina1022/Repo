 338:Core/Src/main.c **** static void Set_Event(uint8_t event_type, uint8_t level)
 339:Core/Src/main.c **** {
 340:Core/Src/main.c ****   /*
 341:Core/Src/main.c ****    * 儲存目前事件。
 342:Core/Src/main.c ****    * LCD 與紅外線發送都使用這兩個狀態。
 343:Core/Src/main.c ****    */
 344:Core/Src/main.c ****   current_event_type = event_type;
 345:Core/Src/main.c ****   current_level = level;
 346:Core/Src/main.c **** 
 347:Core/Src/main.c ****   /*
 348:Core/Src/main.c ****    * 收到新事件後，下一輪立即發送，
 349:Core/Src/main.c ****    * 不必先等待 150 ms。
 350:Core/Src/main.c ****    */
 351:Core/Src/main.c ****   force_send_now = 1U;
 352:Core/Src/main.c ****   last_send_tick = HAL_GetTick();
 353:Core/Src/main.c **** 
 354:Core/Src/main.c ****   if ((event_type == IR_TYPE_NONE) &&
 355:Core/Src/main.c ****       (level == IR_LEVEL_NONE))
 356:Core/Src/main.c ****   {
 357:Core/Src/main.c ****     /*
 358:Core/Src/main.c ****      * SAFE 只送三次，
 359:Core/Src/main.c ****      * 三次結束後停止紅外線。
 360:Core/Src/main.c ****      */
 361:Core/Src/main.c ****     safe_tx_remaining = IR_SAFE_CONFIRM_TX_COUNT;
 362:Core/Src/main.c ****   }
 363:Core/Src/main.c ****   else
 364:Core/Src/main.c ****   {
 365:Core/Src/main.c ****     /*
 366:Core/Src/main.c ****      * Level 1、2、3 或 Error
 367:Core/Src/main.c ****      * 由 IR_Process() 持續發送。
 368:Core/Src/main.c ****      */
 369:Core/Src/main.c ****     safe_tx_remaining = 0U;
 370:Core/Src/main.c ****   }
 371:Core/Src/main.c **** 
 372:Core/Src/main.c ****   /*
 373:Core/Src/main.c ****    * 使用同一事件切換組員做好的 LCD 畫面。
 374:Core/Src/main.c ****    */
 375:Core/Src/main.c ****   LCD_UpdateEvent(event_type, level);
 376:Core/Src/main.c **** }
 377:Core/Src/main.c **** static void Nano_UART_StartReceive(void)
 378:Core/Src/main.c **** {
 379:Core/Src/main.c ****   nano_rx_state = 0U;
 380:Core/Src/main.c ****   nano_packet_ready = 0U;
 381:Core/Src/main.c **** 
 382:Core/Src/main.c ****   if (HAL_UART_Receive_IT(&huart2,
 383:Core/Src/main.c ****                           &nano_rx_byte,
 384:Core/Src/main.c ****                           1U) != HAL_OK)
 385:Core/Src/main.c ****   {
 386:Core/Src/main.c ****     Error_Handler();
 387:Core/Src/main.c ****   }
 388:Core/Src/main.c **** }
 389:Core/Src/main.c **** static void Nano_ProcessPendingPacket(void)
 390:Core/Src/main.c **** {
 391:Core/Src/main.c ****   uint8_t event_code;
ARM GAS  C:\Users\user\AppData\Local\Temp\ccMMIIMQ.s 			page 17


 392:Core/Src/main.c **** 
