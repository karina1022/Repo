 201:Core/Src/main.c **** static void DFPlayer_SendCommand(uint8_t command, uint16_t parameter)
ARM GAS  C:\Users\user\AppData\Local\Temp\cci9psLa.s 			page 5


 202:Core/Src/main.c **** {
 203:Core/Src/main.c ****     uint8_t frame[10];
 204:Core/Src/main.c **** 
 205:Core/Src/main.c ****     frame[0] = 0x7E;                         // 起始碼
 206:Core/Src/main.c ****     frame[1] = 0xFF;                         // 版本
 207:Core/Src/main.c ****     frame[2] = 0x06;                         // 資料長度
 208:Core/Src/main.c ****     frame[3] = command;                      // 命令
 209:Core/Src/main.c ****     frame[4] = 0x00;                         // 不要求回覆
 210:Core/Src/main.c ****     frame[5] = (uint8_t)(parameter >> 8);    // 參數高位
 211:Core/Src/main.c ****     frame[6] = (uint8_t)(parameter & 0xFF);  // 參數低位
 212:Core/Src/main.c **** 
 213:Core/Src/main.c ****     uint16_t checksum = (uint16_t)(
 214:Core/Src/main.c ****         0 - (frame[1] + frame[2] + frame[3]
 215:Core/Src/main.c ****            + frame[4] + frame[5] + frame[6])
 216:Core/Src/main.c ****     );
 217:Core/Src/main.c **** 
 218:Core/Src/main.c ****     frame[7] = (uint8_t)(checksum >> 8);
 219:Core/Src/main.c ****     frame[8] = (uint8_t)(checksum & 0xFF);
 220:Core/Src/main.c ****     frame[9] = 0xEF;                         // 結束碼
 221:Core/Src/main.c **** 
 222:Core/Src/main.c ****     HAL_UART_Transmit(&huart2, frame, 10, 100);
 223:Core/Src/main.c **** 
 224:Core/Src/main.c ****     /* 避免命令傳送太密集 */
 225:Core/Src/main.c ****     HAL_Delay(100);
 226:Core/Src/main.c **** }
