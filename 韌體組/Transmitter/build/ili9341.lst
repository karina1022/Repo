  49:Core/Src/ili9341.c **** 
  50:Core/Src/ili9341.c **** /*
  51:Core/Src/ili9341.c ****  * Match the referenced STM32 example:
  52:Core/Src/ili9341.c ****  * every command byte has its own CS-low / CS-high transaction.
  53:Core/Src/ili9341.c ****  */
  54:Core/Src/ili9341.c **** static void LCD_WriteIndex(uint8_t command)
  55:Core/Src/ili9341.c **** {
  56:Core/Src/ili9341.c ****     LCD_CS_LOW();
  57:Core/Src/ili9341.c ****     LCD_DC_CMD();
  58:Core/Src/ili9341.c **** 
  59:Core/Src/ili9341.c ****     LCD_Transmit(&command, 1U);
  60:Core/Src/ili9341.c **** 
  61:Core/Src/ili9341.c ****     LCD_CS_HIGH();
  62:Core/Src/ili9341.c **** }
  63:Core/Src/ili9341.c **** 
  64:Core/Src/ili9341.c **** 
  65:Core/Src/ili9341.c **** /*
  66:Core/Src/ili9341.c ****  * Match the referenced STM32 example:
  67:Core/Src/ili9341.c ****  * every parameter byte has its own CS-low / CS-high transaction.
  68:Core/Src/ili9341.c ****  */
  69:Core/Src/ili9341.c **** static void LCD_WriteData8(uint8_t data)
  70:Core/Src/ili9341.c **** {
  71:Core/Src/ili9341.c ****     LCD_CS_LOW();
  72:Core/Src/ili9341.c ****     LCD_DC_DATA();
  73:Core/Src/ili9341.c **** 
  74:Core/Src/ili9341.c ****     LCD_Transmit(&data, 1U);
  75:Core/Src/ili9341.c **** 
  76:Core/Src/ili9341.c ****     LCD_CS_HIGH();
  77:Core/Src/ili9341.c **** }
  78:Core/Src/ili9341.c **** 
  79:Core/Src/ili9341.c **** 
  80:Core/Src/ili9341.c **** static void LCD_WriteData16(uint16_t data)
  81:Core/Src/ili9341.c **** {
  82:Core/Src/ili9341.c ****     uint8_t bytes[2];
  83:Core/Src/ili9341.c **** 
  84:Core/Src/ili9341.c ****     bytes[0] = (uint8_t)(data >> 8);
  85:Core/Src/ili9341.c ****     bytes[1] = (uint8_t)(data & 0xFFU);
  86:Core/Src/ili9341.c **** 
  87:Core/Src/ili9341.c ****     LCD_CS_LOW();
  88:Core/Src/ili9341.c ****     LCD_DC_DATA();
