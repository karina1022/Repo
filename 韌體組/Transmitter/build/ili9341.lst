   1:Core/Src/ili9341.c **** #include "ili9341.h"
   2:Core/Src/ili9341.c **** 
   3:Core/Src/ili9341.c **** #include "spi.h"
   4:Core/Src/ili9341.c **** 
   5:Core/Src/ili9341.c **** /*
   6:Core/Src/ili9341.c ****  * STM32F407G-DISC1 -> ILI9341 wiring
   7:Core/Src/ili9341.c ****  * PB13 -> SCK
   8:Core/Src/ili9341.c ****  * PB15 -> SDI/MOSI
   9:Core/Src/ili9341.c ****  * PB12 -> CS
  10:Core/Src/ili9341.c ****  * PC4  -> DC/RS
  11:Core/Src/ili9341.c ****  * PC5  -> RST
  12:Core/Src/ili9341.c ****  *
  13:Core/Src/ili9341.c ****  * SPI2 must be configured as:
  14:Core/Src/ili9341.c ****  * CPOL = High, CPHA = 2 Edge (SPI Mode 3)
  15:Core/Src/ili9341.c ****  * 8-bit, MSB first, software NSS.
  16:Core/Src/ili9341.c ****  */
  17:Core/Src/ili9341.c **** 
  18:Core/Src/ili9341.c **** #define LCD_CS_LOW()   HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET)
  19:Core/Src/ili9341.c **** #define LCD_CS_HIGH()  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_SET)
  20:Core/Src/ili9341.c **** 
  21:Core/Src/ili9341.c **** #define LCD_DC_CMD()   HAL_GPIO_WritePin(GPIOC, GPIO_PIN_4, GPIO_PIN_RESET)
  22:Core/Src/ili9341.c **** #define LCD_DC_DATA()  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_4, GPIO_PIN_SET)
  23:Core/Src/ili9341.c **** 
  24:Core/Src/ili9341.c **** #define LCD_RST_LOW()  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_5, GPIO_PIN_RESET)
  25:Core/Src/ili9341.c **** #define LCD_RST_HIGH() HAL_GPIO_WritePin(GPIOC, GPIO_PIN_5, GPIO_PIN_SET)
  26:Core/Src/ili9341.c **** 
  27:Core/Src/ili9341.c **** //#define LCD_SDI_LOW()  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15, GPIO_PIN_RESET)
  28:Core/Src/ili9341.c **** //#define LCD_SDI_HIGH() HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15, GPIO_PIN_SET)
  29:Core/Src/ili9341.c **** 
  30:Core/Src/ili9341.c **** 
  31:Core/Src/ili9341.c **** static void LCD_Transmit(const uint8_t *data, uint16_t size)
ARM GAS  C:\Users\user\AppData\Local\Temp\ccbDLEFn.s 			page 2


  32:Core/Src/ili9341.c **** {
  33:Core/Src/ili9341.c ****     if ((data == NULL) || (size == 0U))
  34:Core/Src/ili9341.c ****     {
  35:Core/Src/ili9341.c ****         return;
  36:Core/Src/ili9341.c ****     }
  37:Core/Src/ili9341.c **** 
  38:Core/Src/ili9341.c ****     if (HAL_SPI_Transmit(&hspi2, (uint8_t *)data, size, 1000U) != HAL_OK)
  39:Core/Src/ili9341.c ****     {
  40:Core/Src/ili9341.c ****         Error_Handler();
  41:Core/Src/ili9341.c ****     }
  42:Core/Src/ili9341.c **** 
  43:Core/Src/ili9341.c ****     while (__HAL_SPI_GET_FLAG(&hspi2, SPI_FLAG_BSY) != RESET)
  44:Core/Src/ili9341.c ****     {
  45:Core/Src/ili9341.c ****         /* Wait until the last bit has physically left the SPI peripheral. */
  46:Core/Src/ili9341.c ****     }
  47:Core/Src/ili9341.c **** }
